#!/bin/sh
HERE="$(dirname "$(readlink -f "$0")")"
export PATH="$HERE/usr/bin:$PATH"
# Host GTK modules (xapp, canberra) are not shipped and are not required.
GTK_MODULES=
GTK3_MODULES=
export GTK_MODULES GTK3_MODULES
# Chromium in the AppImage cannot use the host GPU sandbox.
# Qt display/GL flags are applied in astro_dwarf.qt_display so Stellarium Web
# can create a WebGL context. Do not set QT_XCB_GL_INTEGRATION=none here.
[ -n "$QTWEBENGINE_DISABLE_SANDBOX" ] || export QTWEBENGINE_DISABLE_SANDBOX=1
[ -n "$NO_AT_BRIDGE" ] || export NO_AT_BRIDGE=1
exec "$HERE/usr/bin/AstroDwarf" "$@"
