#!/bin/sh
# Host GTK modules (xapp, canberra) are not shipped and are not required.
GTK_MODULES=
GTK3_MODULES=
export GTK_MODULES GTK3_MODULES
# Bundled Qt abort()s when GLX cannot match the host GPU driver.
# Software Qt Quick is the portable default; ASTRO_DWARF_QT_SYSTEM=1 uses host OpenGL.
[ -n "$QTWEBENGINE_DISABLE_SANDBOX" ] || export QTWEBENGINE_DISABLE_SANDBOX=1
[ -n "$NO_AT_BRIDGE" ] || export NO_AT_BRIDGE=1
if [ "${ASTRO_DWARF_QT_SYSTEM:-}" != "1" ]; then
    [ -n "$QT_QPA_PLATFORM" ] || export QT_QPA_PLATFORM=xcb
    [ -n "$QT_XCB_GL_INTEGRATION" ] || export QT_XCB_GL_INTEGRATION=none
    [ -n "$QT_QUICK_BACKEND" ] || export QT_QUICK_BACKEND=software
    [ -n "$QSG_RHI_BACKEND" ] || export QSG_RHI_BACKEND=software
    [ -n "$QTWEBENGINE_CHROMIUM_FLAGS" ] || export QTWEBENGINE_CHROMIUM_FLAGS="--enable-webgl --ignore-gpu-blocklist --in-process-gpu --enable-unsafe-swiftshader --use-gl=angle --use-angle=swiftshader"
fi
exec /opt/astro-dwarf/AstroDwarf "$@"
